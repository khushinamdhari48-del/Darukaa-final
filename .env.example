# ---------------------------------------------------------------------------
# All of this is optional. With an empty .env the system runs fully offline:
# the deterministic reasoning engine, the knowledge base, retrieval, the API,
# the CLI and the web client all work with no key and no network.
# ---------------------------------------------------------------------------

# --- LLM layer (optional) ---
# Used ONLY for (a) parsing free text into the site schema and (b) phrasing the
# engine's output. Recommendations, effect sizes, citations, confidence levels
# and time horizons never come from the model.
ANTHROPIC_API_KEY=

# Narration model. Latest Claude models: claude-opus-5, claude-sonnet-5,
# claude-fable-5-1, claude-haiku-4-5-20251001
BIOAI_MODEL=claude-sonnet-5
# Extraction is a cheap structured task, so a small fast model is the right fit.
BIOAI_EXTRACTION_MODEL=claude-haiku-4-5-20251001
BIOAI_MAX_TOKENS=2000
# Set to false to force the deterministic path even when a key is present.
BIOAI_LLM_ENABLED=true

# --- retrieval ---
# hashed_tfidf (default, zero-dependency, offline) | minilm (needs sentence-transformers)
BIOAI_EMBEDDER=hashed_tfidf
# numpy (default, exact cosine, zero-dependency) | chroma (needs chromadb)
BIOAI_VECTOR_BACKEND=numpy
BIOAI_EMBEDDING_DIM=512
BIOAI_INDEX_DIR=.index

# Hybrid fusion weights: semantic / lexical / site-condition match.
BIOAI_W_DENSE=0.45
BIOAI_W_LEXICAL=0.30
BIOAI_W_CONDITION=0.25
BIOAI_TOP_K=12

# --- dialogue ---
BIOAI_MAX_QUESTIONS=3
BIOAI_MIN_COMPLETENESS=0.12
BIOAI_SESSION_TTL=86400
